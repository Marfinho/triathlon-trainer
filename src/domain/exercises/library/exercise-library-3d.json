  {
    "format": "3d",
    "id": "side-plank",
    "title": "Side Plank",
    "subtitle": "Seitstütz auf dem Unterarm",
    "category": "strength",
    "why": "Die seitlichen Bauchmuskeln und der mittlere Gesäßmuskel halten beim Laufen das Becken waagerecht. Der Seitstütz trainiert genau diese seitliche Stabilität.",
    "steps": [
      "Seitlage, Ellbogen unter der Schulter, Unterarm nach vorn, Beine gestreckt übereinander.",
      "Becken anheben, bis Kopf, Rumpf und Beine eine gerade Linie bilden.",
      "Position halten, gleichmäßig atmen, das Becken nicht absinken lassen.",
      "Kontrolliert ablegen, dann die andere Seite."
    ],
    "mistakes": [
      "Die Hüfte sinkt ab oder knickt nach hinten.",
      "Die Schulter sackt ein, der Ellbogen steht nicht unter der Schulter.",
      "Kopf hängt zur Seite."
    ],
    "dose": "2–3 × 20–30 s pro Seite",
    "progression": "Leichter: unteres Knie aufsetzen. Schwerer: oberes Bein anheben.",
    "tempoText": "Becken in 1,5 s heben, 3 s halten, ablegen.",
