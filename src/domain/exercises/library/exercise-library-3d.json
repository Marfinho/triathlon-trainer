  {
    "format": "3d",
    "id": "glute-bridge",
    "title": "Glute Bridge",
    "subtitle": "Gesäßbrücke",
    "category": "strength",
    "why": "Der große Gesäßmuskel streckt beim Laufen die Hüfte und schiebt dich nach vorn. Die Brücke trainiert ihn gezielt, ohne Belastung für Knie und Rücken.",
    "steps": [
      "Rückenlage, Knie gebeugt, Füße hüftbreit flach am Boden, Arme neben dem Körper.",
      "Bauch leicht anspannen und das Becken über die Fersen anheben, bis Schultern, Hüfte und Knie eine Linie bilden.",
      "Oben 1–2 Sekunden das Gesäß fest anspannen, nicht ins Hohlkreuz gehen.",
      "Kontrolliert Wirbel für Wirbel wieder ablegen."
    ],
    "mistakes": [
      "Hohlkreuz oben: Der untere Rücken übernimmt statt des Gesäßes.",
      "Die Knie fallen nach innen oder außen.",
      "Druck auf den Zehen statt auf den Fersen."
    ],
    "dose": "3 × 12–15",
    "progression": "Leichter: weniger Höhe. Schwerer: einbeinig oder mit Gewicht auf dem Becken.",
    "tempoText": "Hoch in 1–2 s, oben 1,5 s halten, ab in 2 s.",
    "view": "side",
    "props": [
      {
        "type": "mat"
      }
    ],
